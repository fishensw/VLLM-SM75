MODEL_ROOT=/srv/models
CACHE_ROOT=/srv/vllm-next/cache
API_BIND=0.0.0.0
API_PORT=18001
ULTRA_DATA_ROOT=/srv/vllm-next/ultra
CONSOLE_PORT=1615
# Panel mode manages its own API key; API-only mode requires VLLM_API_KEY.
IMAGE=vllm-sm75-next-ultra-0924:latest

# 128 GiB host: reserve about 16 GiB for the OS; 256 GiB hosts may use 240g.
MEMORY_LIMIT=112g
