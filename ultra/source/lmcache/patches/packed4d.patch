+class _SubpagedPackedAttentionViewEdit(KVCacheGroupEdit):
+    """Adapt vLLM 0.30 logical packed views to complete physical pages.
+
+    Local adaptation of LMCache PR #4731: vLLM 0.30's
+    ``create_kv_cache_views`` always registers logical ``[B, H, N, C]``.
+    ``kv_layout`` describes physical strides, not the raw tensor axis order.
+    Normalize only after checking the spec; never infer an axis from its size.
+    This must precede LMCache's later format-detection normalization.
+
+    Kernel pages tile one logical block. The returned view preserves every
+    byte and uses one synthetic head; it is opaque transfer metadata rather
+    than semantic attention content. Already-logical pages keep the existing
+    downstream normalization path.
+    """
+
+    name = "subpaged-packed-attention-view"
+
+    def matches(self, spec: KVCacheSpec, kv_cache: RegisteredKVCache) -> bool:
+        return (
+            get_kv_cache_spec_kind(spec) in _SUBPAGEABLE_ATTENTION_KINDS
+            and not _declares_slot_compression(spec)
+            and isinstance(kv_cache, torch.Tensor)
+            and kv_cache.ndim == 4
+            and kv_cache.shape[1:].numel() * kv_cache.element_size()
+            != spec.page_size_bytes
+        )
+
+    def apply(
+        self,
+        spec: KVCacheSpec,
+        kv_cache: RegisteredKVCache,
+        layout_hints: LayoutHints,
+    ) -> torch.Tensor:
+        """Validate logical BHNC, then re-view dense physical logical pages.
+
+        Only the pinned vLLM 0.30 registration contract is supported. Unknown
+        layout hints, slot compression, mismatched spec dimensions, non-dense
+        strides and incomplete or padded pages fail closed without copying.
+        """
+        assert isinstance(kv_cache, torch.Tensor)
+        kv_layout = layout_hints.get("kv_layout", "none")
+        if kv_layout not in ("NHD", "HND"):
+            raise ValueError(
+                f"Unsupported kv_layout: {kv_layout}. Only NHD and HND are supported."
+            )
+        if getattr(spec, "tokens_per_state", None) != 1:
+            raise ValueError("packed vLLM 0.30 attention requires one state per token")
+        if (
+            kv_cache.shape[1] != spec.num_heads
+            or kv_cache.shape[3] * kv_cache.element_size()
+            != spec.state_content_size_bytes
+        ):
+            raise ValueError(
+                "packed vLLM 0.30 KV tensor must match logical [B, H, N, C]: "
+                f"shape={tuple(kv_cache.shape)}, heads={spec.num_heads}, "
+                f"content_bytes={spec.state_content_size_bytes}"
+            )
+        kernel_block_size = kv_cache.shape[2]
+        if kernel_block_size <= 0:
+            raise ValueError("packed attention kernel block size must be positive")
+        physical = (
+            kv_cache.permute(0, 2, 1, 3) if kv_layout == "NHD" else kv_cache
+        )
+        logical_block_size = spec.block_size
+        ratio = _logical_block_ratio(spec, physical, kernel_block_size)
+        num_blocks = physical.shape[0] // ratio
+        elems_per_page = spec.page_size_bytes // physical.element_size()
+        content_size = _synthetic_packed_content_size(
+            elems_per_page, logical_block_size
+        )
+        if kv_layout == "NHD":
+            return physical.view(
+                num_blocks, logical_block_size, _SYNTHETIC_NUM_HEADS, content_size
+            )
+        return physical.view(
+            num_blocks, _SYNTHETIC_NUM_HEADS, logical_block_size, content_size
+        )
+
+
